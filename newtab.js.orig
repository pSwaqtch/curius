t: 700; */\n  padding: 0;\n  color: black;\n}\n\n.sk-chase {\n  width: 40px;\n  height: 40px;\n  position: relative;\n  animation: sk-chase 2.5s infinite linear both;\n}\n\n.sk-chase-dot {\n  width: 100%;\n  height: 100%;\n  position: absolute;\n  left: 0;\n  top: 0; \n  animation: sk-chase-dot 2.0s infinite ease-in-out both; \n}\n\n.sk-chase-dot:before {\n  content: \'\';\n  display: block;\n  width: 25%;\n  height: 25%;\n  background-color: #aaa;\n  border-radius: 100%;\n  animation: sk-chase-dot-before 2.0s infinite ease-in-out both; \n}\n\n.sk-chase-dot:nth-child(1) { animation-delay: -1.1s; }\n.sk-chase-dot:nth-child(2) { animation-delay: -1.0s; }\n.sk-chase-dot:nth-child(3) { animation-delay: -0.9s; }\n.sk-chase-dot:nth-child(4) { animation-delay: -0.8s; }\n.sk-chase-dot:nth-child(5) { animation-delay: -0.7s; }\n.sk-chase-dot:nth-child(6) { animation-delay: -0.6s; }\n.sk-chase-dot:nth-child(1):before { animation-delay: -1.1s; }\n.sk-chase-dot:nth-child(2):before { animation-delay: -1.0s; }\n.sk-chase-dot:nth-child(3):before { animation-delay: -0.9s; }\n.sk-chase-dot:nth-child(4):before { animation-delay: -0.8s; }\n.sk-chase-dot:nth-child(5):before { animation-delay: -0.7s; }\n.sk-chase-dot:nth-child(6):before { animation-delay: -0.6s; }\n\n@keyframes sk-chase {\n  100% { transform: rotate(360deg); } \n}\n\n@keyframes sk-chase-dot {\n  80%, 100% { transform: rotate(360deg); } \n}\n\n@keyframes sk-chase-dot-before {\n  50% {\n    transform: scale(0.4); \n  } 100%, 0% {\n    transform: scale(1.0); \n  }\n} \n\n.curius-tooltip.type-dark.place-top {\n  padding: 0.3rem 0.3rem;\n}\n\n#easter:hover ~#lucky {\n  visibility: visible;\n}\n#lucky {\n  visibility: hidden;\n}\n.tag {\n  background-color: #f5f5f5;\n  margin-right: 5px;\n  border-radius: 7px;\n  padding: 3px 7px;\n  text-transform: capitalize;\n  display: inline-block;\n  cursor: pointer;\n  color: #aaa;\n  font-size: 11px;\n  margin-top: 5px;\n}\n\n.channel {\n  /* text-align: right; */\n  text-transform: uppercase;\n  font-family: Inconsolata, monospace,sans-serif;\n  font-size: 15px;\n  color: #545454;\n  padding: 3px 8px;\n  cursor: pointer;\n  border-radius: 5px;\n  transition: padding-left 0.5s;\n}\n.channel:hover {\n  background-color: #f8f8f8;\n}\n.selected {\n  background-color: #ffe600; \n  /* rgb(223, 231, 236); */\n  /* border: 1px solid black; */\n  padding-left: 10%;\n  color: black;\n}\n.selected:hover {\n  background-color: #ffe600; \n  /* rgb(223, 231, 236); */\n  /* border: 1px solid black; */\n  color: black;\n}\n.smallHeading {\n  padding: 0px 5px;\n  font-family: Source Sans Pro;\n}\n\n.tag:hover {\n    background-color: #eee;\n}\n.line {\n  white-space: nowrap;\n  text-overflow: ellipsis;\n  overflow: hidden;\n}\n.twoline {\n  overflow: hidden;\n  word-break: break-word;\n  text-overflow: ellipsis;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  line-height: 1.6;\n}\n.threeline {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  display: -webkit-box;\n  -webkit-line-clamp: 3;\n  -webkit-box-orient: vertical;\n  line-height: 1.6;\n\n}\n.slantedHeading {\n  font-family: IBM Plex Mono;\n  font-size: 12px;\n  /* font-style: italic; */\n}\n.nameHeading {\n  font-family: EB Garamond;\n  font-size: 18px;\n  margin-left: 5%;\n  /* font-style: italic; */\n  /* font-weight: 700; */\n}\n\n.interpunct::after {\n  content: "\\2022";\n  margin: 10px;\n}\n.interpunct:last-child::after {\n  content: "";\n  margin: 0;\n}\n\n.highlight {\n  cursor: pointer;\n  position: relative;\n  /* line-height: 1.7em;\n  font-size: 15px;\n  line-height: 1.58;\n  font-family: Lora; */\n  display: inline;\n}\n\n.textwindow {\n  font-family: EB Garamond;\n  line-height: 1.7;\n  font-size: 14px;\n  white-space: break-spaces;\n}\n.mask {\n  -webkit-mask-image:-webkit-linear-gradient(top, rgba(255,255,255,0) 0%,rgba(255,255,255,1) 10%,rgba(255,255,255,1) 90%,rgba(255,255,255,0) 100%);\n  max-height:300px;\n}\n.scroll {\n  max-height: 300px;\n  