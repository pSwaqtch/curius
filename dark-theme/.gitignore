# Generated by recolor.py / build.py from the *.orig sources in this
# directory. Everything else under fork/ is tracked, because a fresh clone
# has to be able to build and load the extension without a Web Store copy
# to re-derive assets from.
fork/dist/newtab.js
fork/dist/extension.js
fork/dist/options.js
fork/newtab.html
fork/extension.html
fork/options.html

.DS_Store

# Pre-compressed duplicates of files already tracked uncompressed.
fork/dist/**/*.gz

# Bytecode from apply.sh importing build.py for the version check.
__pycache__/
*.pyc
